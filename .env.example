# La IA dentro del producto (obligatoria)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_EFFORT=high

# La notificación al móvil del jefe (si faltan, solo la campana del panel).
# Si pones el token y dejas el chat_id vacío, `npm run humo` te dice cuál es.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dirección pública (vacío = http://localhost:3000). En producción, el dominio
# de Vercel: con ella se generan los enlaces de los presupuestos y los avisos.
APP_URL=

# La base de datos que usa la app. En local, un fichero libSQL; en Vercel, la
# URL de Turso (libsql://…) con su token.
DATABASE_URL=file:./data/demo.db
DATABASE_AUTH_TOKEN=

# La base de producción en Turso. La app NO las lee: solo las usan los scripts
# que cargan el esquema y el seed en producción, para que tu local siga
# trabajando con el fichero.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# El acceso al panel: una sola contraseña. PANEL_SECRET firma la cookie de
# sesión y CRON_SECRET protege /api/tick. Genera los dos con: openssl rand -hex 32
PANEL_PASSWORD=
PANEL_SECRET=
CRON_SECRET=

# La demo
DEMO_MODE=1
# Hora real de hoy (HH:MM) a la que el seed deja un seguimiento programado; vacío = ninguno
DEMO_ALARMA=

# Seguimientos por email real (opcional)
RESEND_API_KEY=
RESEND_TO=
